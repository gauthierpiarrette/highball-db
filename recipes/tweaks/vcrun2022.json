  "knownIssues": [
    {
      "symptom": "A game still reports a VC++ runtime error after installing",
      "cause": "the game may need an older runtime (2010/2013) or the error text is a generic crash message",
      "fix": "open a GitHub issue with the exact error text and the newest log"
    },
    {
      "symptom": "Install reported as failed with a number like 102, on a bottle where a game or another installer already added VC++",
      "cause": "Microsoft's bundle exits 1638 ('a newer version is already installed'), which POSIX truncates to 102. aka.ms/vs/17 is now the older 14.44 line; the current line (14.51) is served from aka.ms/vc14, so any newer runtime present makes this a no-op.",
      "fix": "Fixed in Highball 0.7.15: benign installer exit codes are treated as success and the log records the real Windows code. Nothing to do — the runtimes are already there."
    }
  ],
